window-decoration = auto
macos-titlebar-style = native
macos-window-buttons = visible
shell-integration = zsh
bell-features = audio,border,no-title,no-attention,no-system
notify-on-command-finish = always
notify-on-command-finish-action = bell
notify-on-command-finish-after = 1s

# フォント設定 - モダンでおしゃれなフォント
font-family = Fira Code
font-size = 14
font-style = Regular
font-feature = +calt
font-feature = +liga

# ウィンドウの見た目
window-padding-x = 25
window-padding-y = 25
window-padding-color = extend
window-width = 140
window-height = 40
window-save-state = always

# 背景の透明度でおしゃれに（めっちゃ薄い透明）
background-opacity = 0.20

# 背景画像
background-image-fit = cover
background-image-position = center

# ウィンドウの装飾
window-decoration = true
macos-titlebar-style = transparent

# アニメーション
quick-terminal-animation-duration = 0.3

# その他のおしゃれ設定
auto-update = download
clipboard-read = allow
clipboard-write = allow

# Keep Option key available for macOS character input such as Option+8/9.
macos-option-as-alt = false

# Send Cmd+Left/Right as standard Home/End so shells and Neovim both understand them.
keybind = super+arrow_left=esc:OH
keybind = super+arrow_right=esc:OF
keybind = super+arrow_up=csi:1;9A
keybind = super+arrow_down=csi:1;9B

# Explicit split bindings. On macOS, super is Cmd.
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+shift+D=new_split:down
keybind = super+alt+d=new_split:down
keybind = super+ctrl+d=new_split:down
keybind = super+shift+s=new_split:down

# Optional settings for files and paths available only on this Mac.
config-file = ?local.config
